// Schema do banco — Gestão de Processos
// tipo:        "atividade" | "projeto"
// status:      "a_fazer" | "em_andamento" | "concluido"
// prioridade:  "baixa" | "media" | "alta"
// recorrencia: "none" | "diaria" | "semanal" | "mensal"
// papel (chat): "user" | "ia"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Multiusuário ────────────────────────────────────────────────────────────
// Propriedade do dado é ancorada em Workspace (não no usuário) desde a Fase A:
// cada usuário nasce com uma workspace pessoal. Na Fase B a mesma workspace
// passa a ter vários membros — sem re-chavear nada.

model Usuario {
  id                String            @id @default(cuid())
  email             String            @unique
  nome              String
  senhaHash         String
  criadoEm          DateTime          @default(now())
  membros           Membro[]
  chats             MensagemChat[]
  pushes            PushSubscription[]
  config            Configuracao?
  tarefasAtribuidas Tarefa[]          @relation("Assignee")
  tarefasCriadas    Tarefa[]          @relation("Criador")
  atividades        Atividade[]
}

model Workspace {
  id       String    @id @default(cuid())
  nome     String
  criadaEm DateTime  @default(now())
  membros    Membro[]
  tarefas    Tarefa[]
  tags       Tag[]
  convites   Convite[]
  atividades Atividade[]
}

model Membro {
  usuarioId   String
  workspaceId String
  papel       String    @default("owner") // owner | admin | membro | leitor
  criadoEm    DateTime  @default(now())
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([usuarioId, workspaceId])
}

// Timeline de uma tarefa: comentários (tipo="comentario", com `texto` do autor)
// e eventos do sistema (criou/status/responsavel, com `texto` = resumo).
model Atividade {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tarefaId    String?
  tarefa      Tarefa?   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String // comentario | criou | status | responsavel
  texto       String?
  criadoEm    DateTime  @default(now())

  @@index([tarefaId, criadoEm])
  @@index([workspaceId, criadoEm])
}

// Convite para entrar numa workspace: aceito por link (token). Sem envio de
// email no free tier — o criador compartilha o link manualmente.
model Convite {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  papel       String    @default("membro") // papel concedido ao aceitar
  email       String? // opcional: sugestão de destinatário
  criadoPor   String // usuarioId de quem convidou
  expiraEm    DateTime
  aceitoEm    DateTime?
  criadoEm    DateTime  @default(now())
}

model Tag {
  id          String      @id @default(cuid())
  nome        String
  cor         String      @default("#6366f1")
  tarefas     TarefaTag[]
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Unicidade por workspace: usuários diferentes podem ter a mesma tag.
  @@unique([workspaceId, nome])
}

model TarefaTag {
  tarefaId String
  tagId    String
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([tarefaId, tagId])
}

model Tarefa {
  id             String          @id @default(cuid())
  tipo           String          @default("atividade")
  titulo         String
  descricao      String?
  prazo          DateTime?
  prazoRigido    Boolean         @default(false)
  prioridade     String          @default("media")
  status         String          @default("a_fazer")
  recorrencia    String          @default("none")
  recorrenciaAte DateTime?
  nivel          String          @default("operacional")
  dataInicio     DateTime?
  duracaoMin     Int?
  tempoGastoMin  Int?
  concluidaEm    DateTime?
  criadaEm       DateTime        @default(now())
  atualizadaEm   DateTime        @updatedAt
  // Status Report (Fase 1): marca a tarefa para aparecer no report; contrato/sc e
  // notas narrativas ficam na própria tarefa (histórico/rastreabilidade).
  noStatusReport      Boolean    @default(false)
  sc                  String?
  statusReportNota    String?
  statusReportNotaCor String?
  proximoPasso        String?
  tags           TarefaTag[]
  lembretes      Lembrete[]
  // Tarefas: relação auto-referencial (pai = projeto/atividade, filhos = tarefas)
  tarefaPaiId    String?
  tarefaPai      Tarefa?         @relation("Tarefas", fields: [tarefaPaiId], references: [id], onDelete: Cascade)
  tarefas        Tarefa[]        @relation("Tarefas")
  // Dependências
  dependeDe      TarefaDep[]     @relation("TarefaDepende")
  dependentes    TarefaDep[]     @relation("TarefaDependente")
  reunioes       Reuniao[]
  // Multiusuário: dono (workspace) em toda linha; assignee só é usado na Fase B.
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       Usuario?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  atividades     Atividade[]
  // Visibilidade por atribuição: rootId = projeto-raiz ancestral (self, se já é raiz);
  // torna a consulta de visibilidade plana/indexável. criadoPorId = autor do item.
  rootId         String?
  criadoPorId    String?
  criadoPor      Usuario?        @relation("Criador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
  @@index([rootId])
  @@index([assigneeId])
  @@index([criadoPorId])
  @@index([noStatusReport])
}

model TarefaDep {
  tarefaId    String
  dependeDeId String
  tarefa      Tarefa @relation("TarefaDepende", fields: [tarefaId], references: [id], onDelete: Cascade)
  dependeDe   Tarefa @relation("TarefaDependente", fields: [dependeDeId], references: [id], onDelete: Cascade)
  @@id([tarefaId, dependeDeId])
}

model Lembrete {
  id         String   @id @default(cuid())
  tarefa     Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  tarefaId   String
  dispararEm DateTime
  enviado    Boolean  @default(false)
  criadoEm   DateTime @default(now())
}

model MensagemChat {
  id             String   @id @default(cuid())
  papel          String
  conteudo       String
  acaoExecutada  String?
  timestamp      DateTime @default(now())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Preferências do planejador diário (linha única, id=1). Tempos em minutos
// desde a meia-noite (ex.: 540 = 09:00).
model Configuracao {
  usuarioId           String   @id
  usuario             Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expedienteInicioMin Int      @default(540)
  expedienteFimMin    Int      @default(1080)
  almocoInicioMin     Int?     @default(720)
  almocoFimMin        Int?     @default(780)
  duracaoPadraoMin    Int      @default(10)
  bufferMin           Int      @default(0)
  atualizadaEm        DateTime @updatedAt
}

// Inscrição de push do navegador (PushSubscription serializada)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadaEm  DateTime @default(now())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Registro de notificação de prazo já enviada — evita reenvio (nivel: "vencendo" | "atrasada")
model NotificacaoEnviada {
  tarefaId  String
  nivel     String
  enviadaEm DateTime @default(now())
  @@id([tarefaId, nivel])
}

model Reuniao {
  id         String    @id @default(cuid())
  tarefaId   String
  tarefa     Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  titulo     String?
  dataHora   DateTime?
  duracaoMin Int?
  topicos    Topico[]
  criadaEm   DateTime  @default(now())
}

model Topico {
  id        String   @id @default(cuid())
  reuniaoId String
  reuniao   Reuniao  @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  titulo    String
  concluido Boolean  @default(false)
  criadoEm  DateTime @default(now())
}
